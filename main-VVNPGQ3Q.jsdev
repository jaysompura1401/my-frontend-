import{a as pe,b as xt,c as G3,d as X3,e as Wo}from"./chunk-FDERIQAA.js";
/* ===== BEGIN: injected 58mm thermal print patch ===== */
window.__THERMAL_BUSINESS_INFO = {
  name: "Gamtu",
  addressLines: ["Surat, Gujarat"],
  phone: "",
  gstin: ""
};
window.__printThermalInvoice = function (ctx) {
  function esc(s){return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}
  function money(n){return (Number(n)||0).toFixed(2);}
  var biz = window.__THERMAL_BUSINESS_INFO || {};
  var items = ctx.selectedItems || [];
  var isProforma = !!ctx.isProforma;
  var subTotal = items.reduce(function(t,e){return t + (Number(e.qty)||0) * (Number(e.custom_price)||0);}, 0);
  var gstPercent = isProforma ? 0 : (ctx.GST_PERCENT || 5);
  var gstAmount = isProforma ? 0 : (subTotal * gstPercent / 100);
  var discount = Number(ctx.discountApplied) || 0;
  var finalTotal = subTotal + gstAmount - discount;
  var halfGstPercent = gstPercent / 2;
  var halfGstAmount = gstAmount / 2;

  var itemRows = items.map(function(item){
    var amt = (Number(item.qty)||0) * (Number(item.custom_price)||0);
    return '<tr><td class="item-name">' + esc(item.name) + '</td>' +
           '<td class="item-qty">' + (item.qty||0) + '</td>' +
           '<td class="item-amt">' + money(amt) + '</td></tr>';
  }).join("");

  var gstLines = (isProforma || gstPercent === 0) ? "" :
    '<div class="gst-line"><span>CGST @ ' + halfGstPercent.toFixed(2) + '%</span><span>' + money(halfGstAmount) + '</span></div>' +
    '<div class="gst-line"><span>SGST @ ' + halfGstPercent.toFixed(2) + '%</span><span>' + money(halfGstAmount) + '</span></div>';

  var discountLine = discount > 0 ?
    '<div class="row"><span>(-) Discount</span><span>' + money(discount) + '</span></div>' : "";

  var now = new Date();
  var pad = function(n){return String(n).padStart(2,"0");};
  var hh = now.getHours(); var ampm = hh >= 12 ? "PM" : "AM"; hh = hh % 12 || 12;
  var dateStr = pad(now.getDate())+"/"+pad(now.getMonth()+1)+"/"+now.getFullYear()+", "+pad(hh)+":"+pad(now.getMinutes())+" "+ampm;

  var html = '<!DOCTYPE html><html><head><meta charset="utf-8"/><title>Invoice</title><style>' +
    '@page{size:58mm auto;margin:0}*{box-sizing:border-box}html,body{margin:0;padding:0;width:58mm}' +
    'body{font-family:"Courier New",Courier,monospace;font-size:11px;line-height:1.35;color:#000;padding:4px 6px}' +
    '.center{text-align:center}.bold{font-weight:bold}.business-name{font-size:13px;font-weight:bold}' +
    '.divider{border-top:1px dashed #000;margin:4px 0}table{width:100%;border-collapse:collapse}' +
    'th{text-align:left;font-size:10px;border-bottom:1px dashed #000;padding-bottom:2px}' +
    'th.item-qty,th.item-amt{text-align:right}td{padding:2px 0;vertical-align:top}' +
    'td.item-name{text-align:left;word-break:break-word}td.item-qty{text-align:center;width:15%}' +
    'td.item-amt{text-align:right;width:30%}.row,.gst-line{display:flex;justify-content:space-between}' +
    '.gst-line{font-size:10px}.total-row{display:flex;justify-content:space-between;font-size:13px;font-weight:bold}' +
    '.footer{font-size:10px;text-align:right;margin-top:6px}' +
    '</style></head><body>' +
    '<div class="center business-name">' + esc(biz.name) + '</div>' +
    (biz.addressLines||[]).map(function(l){return '<div class="center">'+esc(l)+'</div>';}).join("") +
    (biz.phone ? '<div class="center">PHONE : '+esc(biz.phone)+'</div>' : "") +
    (biz.gstin ? '<div class="center">GSTIN : '+esc(biz.gstin)+'</div>' : "") +
    '<div class="divider"></div>' +
    '<div class="center bold">' + (isProforma ? "Proforma Invoice" : "Retail Invoice") + '</div>' +
    '<div class="divider"></div>' +
    '<div>Date : ' + dateStr + '</div>' +
    '<div class="bold">' + esc(ctx.customerName || "Walk-in Customer") + '</div>' +
    '<div>Bill No: ' + esc(ctx.billNumber || "") + '</div>' +
    '<div>Payment Mode: ' + esc(ctx.paymentMode || "cash") + '</div>' +
    '<div class="divider"></div>' +
    '<table><thead><tr><th>Item</th><th class="item-qty">Qty</th><th class="item-amt">Amt</th></tr></thead>' +
    '<tbody>' + itemRows + '</tbody></table>' +
    '<div class="divider"></div>' +
    '<div class="row"><span>Sub Total</span><span>' + money(subTotal) + '</span></div>' +
    discountLine + gstLines +
    '<div class="divider"></div>' +
    '<div class="total-row"><span>TOTAL</span><span>Rs ' + money(finalTotal) + '</span></div>' +
    '<div class="divider"></div>' +
    '<div class="footer">E &amp; O.E</div>' +
    '</body></html>';

  var printWindow = window.open("", "_blank", "width=380,height=600");
  if (!printWindow) { alert("Please allow pop-ups to print the invoice."); return; }
  printWindow.document.open();
  printWindow.document.write(html);
  printWindow.document.close();
  setTimeout(function(){
    printWindow.focus();
    printWindow.print();
  }, 300);
};
